ENVIRONMENT=development
DEBUG=true

CORS_ORIGINS=["http://localhost:3000"]

# Database: Neon (or any hosted Postgres). Use the DIRECT connection
# string from the Neon console (Dashboard -> your project -> Connection
# Details), not the "-pooler" one: this app is a persistent server
# process with its own SQLAlchemy connection pool, so it doesn't need
# Neon's PgBouncer pooler the way a serverless/edge function would — and
# skipping it avoids PgBouncer transaction-mode caveats (e.g. prepared
# statements) entirely. Neon requires TLS, hence sslmode=require.
DATABASE_URL=postgresql+psycopg://user:password@ep-example-123456.us-east-2.aws.neon.tech/ai_coding_agent?sslmode=require

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# LLM_PROVIDER=mock runs the full agent pipeline against a deterministic
# offline stand-in — no API key needed. Switch to "anthropic" + a real key
# for actual model output.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

WORKSPACES_DIR=backend/workspaces
UPLOADS_DIR=backend/uploads
MAX_UPLOAD_SIZE_MB=200

COMMAND_TIMEOUT_SECONDS=120
