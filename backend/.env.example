ENVIRONMENT=development
DEBUG=true

CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_coding_agent

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# LLM_PROVIDER=mock runs the full agent pipeline against a deterministic
# offline stand-in — no API key needed. Switch to "anthropic" + a real key
# for actual model output.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

WORKSPACES_DIR=backend/workspaces
UPLOADS_DIR=backend/uploads
MAX_UPLOAD_SIZE_MB=200

COMMAND_TIMEOUT_SECONDS=120
